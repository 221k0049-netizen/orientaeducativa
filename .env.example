# ============================================================
# NAIMA OS · Configuración de Envío de Correos Reales (Vercel)
# ============================================================

# OPCIÓN A: Usar Gmail (Recomendada con Contraseña de Aplicación)
# Para generar tu contraseña de aplicación de 16 caracteres:
# 1. Ve a tu cuenta de Google > Seguridad > Verificación en dos pasos.
# 2. Al final, entra a "Contraseñas de aplicaciones" y crea una para "NAIMA OS".
# 3. Pega los datos aquí o en Vercel > Project Settings > Environment Variables:

SMTP_USER=tu_correo@gmail.com
SMTP_PASS=abcd efgh ijkl mnop
SMTP_FROM_NAME=NAIMA OS · Orientación CONALEP Mérida I

# Opcional (si usas servidor SMTP personalizado diferente a Gmail):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465

# ------------------------------------------------------------
# OPCIÓN B: Usar Resend (https://resend.com)
# RESEND_API_KEY=re_1234567890abcdef
# RESEND_FROM=alertas@tudominio.com
